# Copy to .env and replace every value before starting Docker.
POSTGRES_USER=investra
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=investra
JWT_SECRET=replace-with-a-32-plus-character-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MAX_UPLOAD_SIZE=10485760
